/*  sbend_bunch_pure_30.in -- generated by make_decks.py (bend validation suite).
    sbend 30 deg bunch, energy spread only (clean dispersion / R56).
    element=SBEND angle=30 deg  HGAP=0.01 m  mode=bunch
    No space charge (FIELDSOLVER TYPE=NONE).
*/

OPTION, PSDUMPFREQ   = 400;
OPTION, STATDUMPFREQ = 5;
OPTION, BOUNDPDESTROY = 1000000;
Option, VERSION = 10900;

Title, string="sbend_bunch_pure_30";

REAL Edes  = 0.1;
REAL gamma = (Edes + EMASS) / EMASS;
REAL beta  = sqrt(1 - (1 / gamma^2));
REAL P0    = gamma * beta * EMASS;          // GeV/c; also sets OpalData P0 (field ref)

REAL bend_angle = 0.5235987755982988;
REAL L_BEND     = 1;
REAL Z_IN       = 1;
REAL Z_OUT      = 2;              // exit face = Z_IN + design arc length

D_IN:  DRIFT, L = Z_IN, ELEMEDGE = 0.0;
BEND:  SBEND, L = L_BEND, ELEMEDGE = Z_IN,
       ANGLE = bend_angle,
       HGAP = 0.01,
       HAPERT = 0.15,
       DESIGNENERGY = 100;
D_OUT: DRIFT, L = 2, ELEMEDGE = Z_OUT;

BendLine: Line = (D_IN, BEND, D_OUT);

FS1: Fieldsolver, TYPE = NONE,
     NX = 16, NY = 16, NZ = 16,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

REAL n_particles = 8000;
REAL PC_beam = P0 * 1;        // bunch mean momentum (on design)
Dist: DISTRIBUTION, TYPE = GAUSS,
      SIGMAX = 1e-06, SIGMAPX = 1.966925763e-07,
      SIGMAY = 1e-06, SIGMAPY = 1.966925763e-07,
      SIGMAZ = 1e-06, SIGMAPZ = 0.1966925763,
      NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist;
mySources: EMISSIONSOURCELIST = (ES1);
BEAM1: BEAM, PARTICLE = ELECTRON, PC = PC_beam, NALLOC = n_particles,
       BCHARGE = 1.6e-15, SOURCES = mySources, CHARGE = -1;

TRACK, LINE = BendLine, BEAM = BEAM1,
       MAXSTEPS = 2000000, DT = 1e-12, ZSTOP = 4;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
