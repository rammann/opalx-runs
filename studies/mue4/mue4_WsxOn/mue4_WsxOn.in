/*  mue4_WsxOn.in
    OPALX deck — muE4 beamline, WSX-solenoid-ON configuration.

    Translated from mue4_WsxOn.g4bl (G4beamline, L. Desorgher). mu+ at 28 MeV/c
    through: WSX solenoid -> ASR61 dipole (+40 deg) -> quad triplet -> ASR62
    dipole (-34 deg) -> quad triplet -> ASR62 dipole (+34 deg) -> 2 quad triplets.

    APERTURE SCRAPING IS ACTIVE (branch implement-aperture): every element's
    APERTURE now deletes out-of-aperture particles during tracking, so the
    collimators FS61/FS62/FS63 are REAL scraping elements (DRIFT + APERTURE),
    not placeholders. Realistic beam-pipe apertures match g4bl's geometry:
    drifts circle(0.60) = +/-300 mm (g4bl SECTION tube), quads circle(0.40) =
    +/-200 mm (g4bl QSM_PIPE), solenoid circle(0.44) = +/-220 mm (WSX housing),
    bends HAPERT = 0.20 m horizontally and HGAP = 0.02 m vertically (the pole gap
    is the vertical wall, so the dipoles scrape hard in y).
      NOTE 1: any element WITHOUT an explicit APERTURE defaults to a +/-0.5 m
      circle and would scrape there too. So the diagnostic MONITORs are given
      DELETEONTRANSVERSEEXIT=FALSE to record the full beam without scraping.
      NOTE 2 (LINE order): elements are placed by ELEMEDGE, but the LINE must be
      listed in increasing s or the aperture pass / monitors past the first
      out-of-order element are silently dropped. Keep the LINE s-sorted.

    RESULT / KNOWN ISSUE: with these realistic apertures the beam is scraped away
    in quad triplet 1 (Q1 defocuses x; the beam arrives DIVERGENT -- x' up to
    ~180 mrad, ~2x g4bl -- and blows past +/-200 mm before Q2 refocuses). Only
    ~8 of the 20 monitor planes populate. FS61 does scrape (1911 -> 1673). This is
    the analytic-optics fidelity gap (no 3D field maps): the analytic solenoid/
    dipole deliver a more divergent beam to the triplet than g4bl's real field
    maps do, and the working apertures now make that visible. See monitor_plots/.

    HOW THE G4BL MODEL MAPS TO OPALX (see the translation guide for full detail):
      * beam       : g4bl `beam ascii ... rotation=Y270`  -> DISTRIBUTION FROMFILE.
                     Converted by tools/bltrack_to_opalx.py: Y270 rotation
                     (x,y,z)->(-z,y,x), mm->m, MeV/c->beta*gamma, AND an angular
                     cut (theta < 0.2 rad ~ channel acceptance). The cut is needed
                     because OPAL-T sets the reference orbit from the average of all
                     particle momenta; the raw wide-angle file averages to ~18 MeV/c
                     forward (vs 28 design) and the reference would over-bend. After
                     the cut the average is 0.258 beta*gamma ~ 27.5 MeV/c forward.
      * WSX sol.   : g4bl cylinder Bz map -> on-axis Astra-1D magnetostatic map
                     (tools/g4blmap_solenoid_to_astra.py); KS=1 = g4bl current=1.
      * dipoles    : g4bl `cornerarc`+ASR map -> analytic SBEND (bends frame AND
                     beam). Field from the P0 deck variable + ANGLE. HGAP=0.02 soft
                     Enge fringe (hard edge leaks ~11% of |p|; soft conserves 0.0%).
                     HGAP also sets the VERTICAL half-aperture (+/-20 mm); HAPERT
                     sets the horizontal one (+/-200 mm, the beam-pipe half-width).
      * quads      : g4bl QSM600 map x `current` -> analytic K1 (GL=0.302 T at
                     210 A from tools/g4blmap_quad_gradient.py; K1 = QSM_K1_SCALE*I).
      * collimators: DRIFT + APERTURE, now SCRAPING. rectangle(a,b) is the FULL gap
                     (a x b); stored as half. FS62 (g4bl slit inside dipole 2) is a
                     horizontal-only momentum slit. A bend's aperture is constant over
                     its whole body, so a slit at one s cannot be an SBEND attribute;
                     it is modelled as a thin scraping drift at the BEND2 exit.
      * monitors   : g4bl `zntuple z=... coordinates=centerline` (phase space before
                     & after each element) -> 20 MONITOR planes at the same path
                     lengths. Each writes mon_NN_*.h5 (full 6D, co-moving frame).
      * space chg  : g4bl totalCharge=1 (off) -> Fieldsolver TYPE=NONE.

    LIMITS: analytic SBEND/quad fields (no 3D maps); no Geant4 material physics
    (aperture scraping is a hard geometric cut, no scattering/energy loss); no spin
    tracking; muon decay OFF (add GLOBALPROCESSES={"DECAY"} + a DAUGHTERBEAM). The
    dipole aperture is now rectangular, HAPERT x HGAP, but still constant along the
    magnet, so the real chamber's s-dependence is not represented.
    Verify SBEND ANGLE signs / quad focusing planes against a g4bl profile run.
*/

OPTION, PSDUMPFREQ    = 100;   // phase-space .h5 dump every 100 steps
OPTION, STATDUMPFREQ  = 1;     // beam moments (sigma, emittance, N) every step -> .stat
OPTION, BOUNDPDESTROY = 10;    // statistical 10-sigma loss box (separate from apertures)
OPTION, VERSION       = 10900;

Title, string="muE4 beamline — WSX On (scraping collimators + phase-space monitors)";

// ============================================================================
// Reference particle / global constants
// ============================================================================
REAL MUON_MASS = 0.1056583755;                 // muon rest mass [GeV]
REAL P0        = 0.028;                         // reference momentum [GeV/c]  (g4bl P=28 MeV/c)
REAL Edes      = sqrt(P0*P0 + MUON_MASS*MUON_MASS) - MUON_MASS; // kinetic energy [GeV]
REAL Brho      = P0 / 0.299792458;             // magnetic rigidity [T*m] = 0.09340

REAL n_particles       = 14462;                // all accepted muons (matches beam_WsxOn.dat, theta<0.2)
REAL beam_bunch_charge = 1e-15;                // nominal bunch charge [C] (space charge is OFF)

value, {P0, Edes, Brho};

// ============================================================================
// Quadrupole calibration  (K1_n = QSM_K1_SCALE * I_Qn)
// ============================================================================
REAL L_QUAD       = 0.395;
REAL QSM_K1_SCALE = 8.188865;                  // = GL/(L_QUAD*Brho) [m^-2]  (GL=0.302 T, 210 A map)

REAL I_Q1  = -0.21340;  REAL I_Q2  =  0.65120;  REAL I_Q3  = -0.34970;   // triplet 1
REAL I_Q4  = -0.19590;  REAL I_Q5  =  0.62790;  REAL I_Q6  = -0.37040;   // triplet 2
REAL I_Q7  = -0.32150;  REAL I_Q8  =  0.63400;  REAL I_Q9  = -0.31780;   // triplet 3
REAL I_Q10 =  0.45180;  REAL I_Q11 = -0.90530;  REAL I_Q12 =  0.88900;   // triplet 4 (final focus)

// ============================================================================
// Element definitions  (ELEMEDGE = entrance path length [m]; positions from g4bl)
//   Beam pipe: drifts circle(0.60) = +/-300 mm (g4bl SECTION); quads circle(0.40)
//   = +/-200 mm (QSM_PIPE); solenoid circle(0.44) = +/-220 mm (WSX housing).
//   rectangle/circle args are FULL width/diameter (stored as half).
// ============================================================================

// WSX solenoid (on-axis Bz map, peak 0.260 T at ~1.635 m; map carries lab z).
SOL   : SOLENOID, L = 2.7850, ELEMEDGE = 0.00000,
        FMAPFN = "../../../data/wsx_solenoid_1D.map", KS = 1.0, APERTURE = "circle(0.44)";

// Sector dipoles (ASR61 / ASR62). Field from P0 + ANGLE; HAPERT = pipe half-gap (scrapes).
BEND1 : SBEND, L = 0.8091, ELEMEDGE =  2.57800, ANGLE = +0.69813, HGAP = 0.02, HAPERT = 0.20, DESIGNENERGY = Edes*1000; // +40 deg
BEND2 : SBEND, L = 0.7238, ELEMEDGE =  7.14246, ANGLE = -0.59341, HGAP = 0.02, HAPERT = 0.20, DESIGNENERGY = Edes*1000; // -34 deg
BEND3 : SBEND, L = 0.7238, ELEMEDGE = 11.67044, ANGLE = +0.59341, HGAP = 0.02, HAPERT = 0.20, DESIGNENERGY = Edes*1000; // +34 deg

// Quadrupoles (12 x QSM600). K1 from the calibration above; +/-200 mm pipe.
Q1  : QUADRUPOLE, L = L_QUAD, ELEMEDGE =  4.53789, K1 = QSM_K1_SCALE * I_Q1,  APERTURE = "circle(0.40)";
Q2  : QUADRUPOLE, L = L_QUAD, ELEMEDGE =  5.04289, K1 = QSM_K1_SCALE * I_Q2,  APERTURE = "circle(0.40)";
Q3  : QUADRUPOLE, L = L_QUAD, ELEMEDGE =  5.54789, K1 = QSM_K1_SCALE * I_Q3,  APERTURE = "circle(0.40)";
Q4  : QUADRUPOLE, L = L_QUAD, ELEMEDGE =  9.06587, K1 = QSM_K1_SCALE * I_Q4,  APERTURE = "circle(0.40)";
Q5  : QUADRUPOLE, L = L_QUAD, ELEMEDGE =  9.57087, K1 = QSM_K1_SCALE * I_Q5,  APERTURE = "circle(0.40)";
Q6  : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 10.07587, K1 = QSM_K1_SCALE * I_Q6,  APERTURE = "circle(0.40)";
Q7  : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 13.23336, K1 = QSM_K1_SCALE * I_Q7,  APERTURE = "circle(0.40)";
Q8  : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 13.73836, K1 = QSM_K1_SCALE * I_Q8,  APERTURE = "circle(0.40)";
Q9  : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 14.24336, K1 = QSM_K1_SCALE * I_Q9,  APERTURE = "circle(0.40)";
Q10 : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 17.27336, K1 = QSM_K1_SCALE * I_Q10, APERTURE = "circle(0.40)";
Q11 : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 17.77836, K1 = QSM_K1_SCALE * I_Q11, APERTURE = "circle(0.40)";
Q12 : QUADRUPOLE, L = L_QUAD, ELEMEDGE = 18.28336, K1 = QSM_K1_SCALE * I_Q12, APERTURE = "circle(0.40)";

// Collimators (SCRAPING). rectangle(a,b) = FULL gap a x b.
FS61 : DRIFT, L = 0.100, ELEMEDGE =  3.93039, APERTURE = "rectangle(0.380,0.210)"; // +/-190 x +/-105 mm
FS63 : DRIFT, L = 0.100, ELEMEDGE = 11.17687, APERTURE = "rectangle(0.384,0.217)"; // +/-192 x +/-108 mm
// FS62 momentum slit (g4bl inside BEND2 at 7.504; horizontal +/-190 mm only).
// Modelled as a thin scraping drift at the BEND2 exit; vertical left open (+/-1 m).
FS62 : DRIFT, L = 0.100, ELEMEDGE =  7.86626, APERTURE = "rectangle(0.380,2.000)"; // +/-190 mm horizontal

// Drift fills (beam pipe +/-200 mm)
D1  : DRIFT, L = 0.5433, ELEMEDGE =  3.38710, APERTURE = "circle(0.60)";
D2  : DRIFT, L = 0.5075, ELEMEDGE =  4.03039, APERTURE = "circle(0.60)";
D3  : DRIFT, L = 0.1100, ELEMEDGE =  4.93289, APERTURE = "circle(0.60)";
D4  : DRIFT, L = 0.1100, ELEMEDGE =  5.43789, APERTURE = "circle(0.60)";
D5  : DRIFT, L = 1.1996, ELEMEDGE =  5.94289, APERTURE = "circle(0.60)";
D6  : DRIFT, L = 1.1996, ELEMEDGE =  7.86626, APERTURE = "circle(0.60)";
D7  : DRIFT, L = 0.1100, ELEMEDGE =  9.46087, APERTURE = "circle(0.60)";
D8  : DRIFT, L = 0.1100, ELEMEDGE =  9.96587, APERTURE = "circle(0.60)";
D9  : DRIFT, L = 0.7060, ELEMEDGE = 10.47087, APERTURE = "circle(0.60)";
D10 : DRIFT, L = 0.3936, ELEMEDGE = 11.27687, APERTURE = "circle(0.60)";
D11 : DRIFT, L = 0.8391, ELEMEDGE = 12.39424, APERTURE = "circle(0.60)";
D12 : DRIFT, L = 0.1100, ELEMEDGE = 13.62836, APERTURE = "circle(0.60)";
D13 : DRIFT, L = 0.1100, ELEMEDGE = 14.13336, APERTURE = "circle(0.60)";
D14 : DRIFT, L = 2.6350, ELEMEDGE = 14.63836, APERTURE = "circle(0.60)";
D15 : DRIFT, L = 0.1100, ELEMEDGE = 17.66836, APERTURE = "circle(0.60)";
D16 : DRIFT, L = 0.1100, ELEMEDGE = 18.17336, APERTURE = "circle(0.60)";
D17 : DRIFT, L = 0.5616, ELEMEDGE = 18.67836, APERTURE = "circle(0.60)";

// ============================================================================
// Phase-space monitors — before & after each element group (g4bl zntuple planes).
// DELETEONTRANSVERSEEXIT=FALSE so they record the full beam (no +/-0.5 m default cut).
// Each writes <name>.h5 (full 6D, co-moving/centerline frame).
// ============================================================================
mon_01_sol_in   : MONITOR, ELEMEDGE =  0.300, DELETEONTRANSVERSEEXIT = FALSE;
mon_02_sol_out  : MONITOR, ELEMEDGE =  2.300, DELETEONTRANSVERSEEXIT = FALSE;
mon_03_bend1_in : MONITOR, ELEMEDGE =  2.680, DELETEONTRANSVERSEEXIT = FALSE;
mon_04_bend1_out: MONITOR, ELEMEDGE =  3.300, DELETEONTRANSVERSEEXIT = FALSE;
mon_05_fs61_in  : MONITOR, ELEMEDGE =  3.850, DELETEONTRANSVERSEEXIT = FALSE;
mon_06_fs61_out : MONITOR, ELEMEDGE =  4.100, DELETEONTRANSVERSEEXIT = FALSE;
mon_07_q1_in    : MONITOR, ELEMEDGE =  4.450, DELETEONTRANSVERSEEXIT = FALSE;
mon_08_q1_out   : MONITOR, ELEMEDGE =  6.050, DELETEONTRANSVERSEEXIT = FALSE;
mon_09_bend2_in : MONITOR, ELEMEDGE =  7.150, DELETEONTRANSVERSEEXIT = FALSE;
mon_10_bend2_out: MONITOR, ELEMEDGE =  7.850, DELETEONTRANSVERSEEXIT = FALSE;
mon_11_q2_in    : MONITOR, ELEMEDGE =  8.950, DELETEONTRANSVERSEEXIT = FALSE;
mon_12_q2_out   : MONITOR, ELEMEDGE = 10.600, DELETEONTRANSVERSEEXIT = FALSE;
mon_13_fs63_in  : MONITOR, ELEMEDGE = 11.100, DELETEONTRANSVERSEEXIT = FALSE;
mon_14_fs63_out : MONITOR, ELEMEDGE = 11.350, DELETEONTRANSVERSEEXIT = FALSE;
mon_15_bend3_in : MONITOR, ELEMEDGE = 11.750, DELETEONTRANSVERSEEXIT = FALSE;
mon_16_bend3_out: MONITOR, ELEMEDGE = 12.350, DELETEONTRANSVERSEEXIT = FALSE;
mon_17_q3_in    : MONITOR, ELEMEDGE = 13.150, DELETEONTRANSVERSEEXIT = FALSE;
mon_18_q3_out   : MONITOR, ELEMEDGE = 14.750, DELETEONTRANSVERSEEXIT = FALSE;
mon_19_q4_in    : MONITOR, ELEMEDGE = 17.150, DELETEONTRANSVERSEEXIT = FALSE;
mon_20_q4_out   : MONITOR, ELEMEDGE = 18.800, DELETEONTRANSVERSEEXIT = FALSE;

// ============================================================================
// Beamline  (elements are placed by ELEMEDGE; LINE order is not significant)
// ============================================================================
muE4line: Line = (
    SOL, mon_01_sol_in, mon_02_sol_out, BEND1, mon_03_bend1_in,
    mon_04_bend1_out, D1, mon_05_fs61_in, FS61, D2,
    mon_06_fs61_out, mon_07_q1_in, Q1, D3, Q2,
    D4, Q3, D5, mon_08_q1_out, BEND2,
    mon_09_bend2_in, mon_10_bend2_out, D6, FS62, mon_11_q2_in,
    Q4, D7, Q5, D8, Q6,
    D9, mon_12_q2_out, mon_13_fs63_in, FS63, D10,
    mon_14_fs63_out, BEND3, mon_15_bend3_in, mon_16_bend3_out, D11,
    mon_17_q3_in, Q7, D12, Q8, D13,
    Q9, D14, mon_18_q3_out, mon_19_q4_in, Q10,
    D15, Q11, D16, Q12, D17,
    mon_20_q4_out
);

// ============================================================================
// Beam distribution (converted BLTrackFile; full stats: beam_WsxOn.dat, n=14462)
// ============================================================================
Dist1: DISTRIBUTION, TYPE = FROMFILE,
    FNAME     = "../../../data/beam_WsxOn.dat",
    NPARTDIST = n_particles;

ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1;   // EMISSIONMODEL defaults NONE (required by FROMFILE)
mySources: EMISSIONSOURCELIST = (ES1);

// ============================================================================
// Field solver — space charge OFF (matches g4bl totalCharge=1)
// ============================================================================
FS1: Fieldsolver, TYPE = NONE,
    NX = 16, NY = 16, NZ = 16,
    PARFFTX = true, PARFFTY = true, PARFFTZ = true,
    BCFFTX = open, BCFFTY = open, BCFFTZ = open,
    BBOXINCR = 1, GREENSF = INTEGRATED;

// ============================================================================
// Beam — mu+ at 28 MeV/c. FROMFILE forbids PC on BEAM; field reference is P0.
// ============================================================================
BEAM1: BEAM, PARTICLE = MUON, NALLOC = n_particles,
       BCHARGE = beam_bunch_charge, SOURCES = mySources, CHARGE = +1;

// ============================================================================
// Tracking
// ============================================================================
TRACK, LINE = muE4line, BEAM = BEAM1,
       MAXSTEPS = 100000,
       DT = {1e-11},          // time step [s]  (~0.77 mm/step at beta=0.256)
       ZSTOP = 19.25;         // end of beamline [m]
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
