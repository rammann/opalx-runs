/*  wsx_solenoid.in -- muE4 WSX solenoid, ISOLATED, for comparison against G4BL.

    Paired with wsx_solenoid.g4bl. The same 13 particles (parts.txt / beam.txt,
    both written by compare.ipynb) go through the same field map in both codes.
    No space charge, no scraping, no decay -- only the solenoid field can cause
    a difference.

    FRAME: s here [m] * 1000 == global z in wsx_solenoid.g4bl [mm], exactly.
      The map's own z runs -1500..+1500 mm. OPALX places a map as
      z_lab = ELEMEDGE + z_map, so ELEMEDGE is the lab position of the map
      CENTRE, not of the field start. ELEMEDGE = 1.800 therefore puts the field
      at s = 0.300..3.300 m, matching g4bl's `place MAG z=1800`.

    L on the solenoid is nominal. The field extent comes entirely from the map;
    L only sets the aperture body window and the s-advance, and Solenoid::isInside
    tests the field extent anyway. It is set to 1.500 so the body stops exactly
    where D_OUT starts.

    Run from this directory (FMAPFN and FNAME resolve against the working dir):
      mpirun -n 1 <opalx> wsx_solenoid.in --info 1 > run.log 2>&1
    One rank only -- particle-to-row identity across ranks is not guaranteed.
*/

OPTION, PSDUMPFREQ    = 100000;   // the monitors carry the physics; skip phase-space dumps
OPTION, STATDUMPFREQ  = 1;        // Bz_ref every step -> the on-axis field check
OPTION, BOUNDPDESTROY = 1000000;  // never trip the statistical loss box
OPTION, VERSION       = 10900;

Title, string="g4bl_compare / wsx_solenoid_gaussdist";

// ============================================================================
// Reference particle
// ============================================================================
REAL MUON_MASS = 0.1056583755;              // GeV
REAL P0        = 0.028;                     // GeV/c -- g4bl `referenceMomentum=28`.
                                            //   FROMFILE forbids PC on BEAM; the field
                                            //   reference comes from this variable.
REAL BG0       = P0 / MUON_MASS;            // beta*gamma = 0.2650033
REAL BRHO      = P0 / 0.299792458;          // 0.093398 T*m

value, {P0, BG0, BRHO};

// ============================================================================
// Lattice
// ============================================================================
REAL Z_CENTRE = 1.800;                      // lab s of the map centre = g4bl place z
REAL Z_STOP   = 3.600;

D_IN    : DRIFT, L = 0.300, ELEMEDGE = 0.000;
SOL     : SOLENOID, L = 1.500, ELEMEDGE = Z_CENTRE,
          FMAPFN = "../../../../g4bl-files/muE4/maps/wsx_total.g4blmap",
          KS = 1.0,                         // plain multiplier on the map, = g4bl current=1.
          ZREVERSE = TRUE;                  // g4bl's `rotation=Y180`: mirror the map in z and
                                            //   negate Bz, leaving Br alone. The map peaks at
                                            //   map-local +350 mm, so it is not z-symmetric and
                                            //   this cannot be folded into KS (that would negate
                                            //   Br too). Without it the peak lands at s = 2.150 m
                                            //   with the wrong sign instead of at s = 1.450 m.
D_OUT   : DRIFT, L = 0.300, ELEMEDGE = 3.300;

MON_01 : MONITOR, ELEMEDGE = 0.150, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_01_Z150";
MON_02 : MONITOR, ELEMEDGE = 0.600, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_02_Z600";
MON_03 : MONITOR, ELEMEDGE = 1.050, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_03_Z1050";
MON_04 : MONITOR, ELEMEDGE = 1.500, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_04_Z1500";
MON_05 : MONITOR, ELEMEDGE = 1.950, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_05_Z1950";
MON_06 : MONITOR, ELEMEDGE = 2.400, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_06_Z2400";
MON_07 : MONITOR, ELEMEDGE = 2.850, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_07_Z2850";
MON_08 : MONITOR, ELEMEDGE = 3.450, DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_08_Z3450";

// LINE must be listed in increasing ELEMEDGE or later elements are silently dropped.
SolLine : LINE = (D_IN, MON_01, MON_02, MON_03, MON_04, SOL,
                  MON_05, MON_06, MON_07, D_OUT, MON_08);

// ============================================================================
// Field solver -- space charge OFF (g4bl has no collective effects here)
// ============================================================================
FS1: FIELDSOLVER, TYPE = NONE,
     NX = 16, NY = 16, NZ = 16,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,   // required even for TYPE = NONE
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

// ============================================================================
// Beam -- the shared 13-particle set
// ============================================================================
REAL n_particles = 15000;

// Gaussian generated by OPALX. Units: SIGMAX/Y/Z in m, SIGMAPX/Y/Z in beta*gamma
// -- so a 2 mrad SLOPE (which is what g4bl's sigmaXp is) becomes 2e-3 * BG0.
//
// CUTOFF* default to 3.0 and HARD-TRUNCATE the sampling range (Gaussian.cpp draws
// by inverse transform over [-cutoff*sigma, +cutoff*sigma]). g4bl does not truncate
// at all, so they are widened to 10 sigma here; at 3 sigma OPALX would put exactly
// zero particles in the tails where g4bl puts ~0.27% per axis.
//
// SIGMAPZ is 1e-9 rather than 0: a zero width is degenerate for the sampler.
Dist1: DISTRIBUTION, TYPE = GAUSS,
    SIGMAX  = 10.0e-3, SIGMAY  = 3.0e-3, SIGMAZ  = 1.0e-3,
    SIGMAPX = 2.0e-3 * BG0, SIGMAPY = 2.0e-3 * BG0, SIGMAPZ = 1.0e-9,
    CUTOFFX = 10.0, CUTOFFY = 10.0, CUTOFFLONG = 10.0,
    CUTOFFPX = 10.0, CUTOFFPY = 10.0, CUTOFFPZ = 10.0,
    NPARTDIST = n_particles;

ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1;
mySources: EMISSIONSOURCELIST = (ES1);

// PC is REQUIRED here and forbidden with FROMFILE: TrackRun sets the distribution's
// average pz from the BEAM momentum (getMomentum()/getMass() = beta*gamma). Without
// it the Gaussian would be generated around pz = 0.
// CHARGE = 1 is mandatory: ParticleProperties maps MUON -> -1.
BEAM1: BEAM, PARTICLE = MUON, PC = P0, NALLOC = n_particles,
       BCHARGE = 1e-15, SOURCES = mySources, CHARGE = 1;

// ============================================================================
// Tracking
// ============================================================================
// beta = 0.2562, beta*c = 76.8 mm/ns, so DT = 1e-11 s is 0.77 mm/step:
// ~13 steps per 10 mm map cell and ~2900 steps per cyclotron period at the
// 0.26 T peak. ~4700 steps over the 3.6 m line.
TRACK, LINE = SolLine, BEAM = BEAM1,
       MAXSTEPS = 200000,
       DT = {1e-11},
       ZSTOP = Z_STOP;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
