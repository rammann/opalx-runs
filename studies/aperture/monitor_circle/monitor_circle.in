/*  monitor_circle.in -- generated by make_decks.py (aperture validation suite).
    Element under test: a MONITOR carrying APERTURE = "CIRCLE(0.02)". MON_SCRAPE records every particle and then scrapes: monitor recording has no aperture gate.

    Lattice: DRIFT -> MON_IN -> MONITOR(aperture) -> MON_OUT -> DRIFT.
    Straight line, no fields, no space charge: transverse coordinates are
    exactly invariant, so the survivor set is exactly the grid points inside
    the aperture. Every grid point keeps >= 20% relative clearance from
    the aperture boundary.
    Monitors sit 0.1 m clear of the element body so their +-5 mm
    selection window never overlaps the marking window.
*/

OPTION, PSDUMPFREQ    = 2000;
OPTION, STATDUMPFREQ  = 5;
OPTION, BOUNDPDESTROY = 1000000;      // the sigma-outlier cut must never fire
Option, VERSION = 10900;

Title, string="monitor_circle";

REAL Edes  = 0.1;
REAL gamma = (Edes + EMASS) / EMASS;
REAL beta  = sqrt(1 - (1 / gamma^2));
REAL P0    = gamma * beta * EMASS;    // GeV/c; also sets OpalData P0 (field ref)

D_IN:    DRIFT,   L = 0.5, ELEMEDGE = 0.0;
MON_IN:  MONITOR, ELEMEDGE = 0.4, DELETEONTRANSVERSEEXIT = FALSE;
MON_SCRAPE: MONITOR, ELEMEDGE = 0.5,
            APERTURE = "CIRCLE(0.02)";
MON_OUT: MONITOR, ELEMEDGE = 0.7, DELETEONTRANSVERSEEXIT = FALSE;
D_OUT:   DRIFT,   L = 0.5, ELEMEDGE = 0.6;

ApLine: Line = (D_IN, MON_IN, MON_SCRAPE, MON_OUT, D_OUT);

FS1: Fieldsolver, TYPE = NONE,
     NX = 16, NY = 16, NZ = 16,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

REAL n_particles = 57;
Dist: DISTRIBUTION, TYPE = FROMFILE, FNAME = "parts.txt", NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist;
mySources: EMISSIONSOURCELIST = (ES1);
BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = n_particles,
       BCHARGE = 1.6e-15, SOURCES = mySources, CHARGE = -1;

TRACK, LINE = ApLine, BEAM = BEAM1,
       MAXSTEPS = 2000000, DT = 1e-12, ZSTOP = 1;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
