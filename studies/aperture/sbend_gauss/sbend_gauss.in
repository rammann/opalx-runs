/*  sbend_gauss.in -- generated by make_decks.py (aperture validation suite).
    Element under test: SBEND bending 6 deg with HAPERT = 0.04 m, Enge fringe (HGAP = 0.01), with a 5000-particle Gaussian beam. sigma_x = 2 mm is far inside the horizontal budget, so the aperture decision is purely vertical and stays exact.

    HAPERT installs a SQUARE aperture -- half-width AND half-height are both
    HAPERT. SBEND rejects the APERTURE attribute, so HAPERT is the only knob.
    Lattice: DRIFT -> MON_IN -> SBEND -> MON_OUT -> DRIFT.

    Purely VERTICAL launch grid (x = 0, y varied): a sector-bend dipole exerts
    no vertical force, and a particle at x = 0 rides the design orbit, so the
    survivor set is exactly {|y| < HAPERT}. Minimum clearance 25%.

    HGAP = 0.01 -> full gap 0.02 m -> Enge fringe half width 0.1 m.

    The aperture is marked over the geometric body [0, arc) only -- SBend's
    override changes the COORDINATES (to arc coordinates), not the window.
    Monitor standoff 0.25 m > the fringe reach, so MON_IN records the
    full launched set before any marking can occur.
    RBEND note: its local frame is the box frame, so the design orbit bows off
    axis by the sagitta 0 m, against a horizontal half-aperture of
    0.04 m (100% clear).
*/

OPTION, PSDUMPFREQ    = 2000;
OPTION, STATDUMPFREQ  = 5;
OPTION, BOUNDPDESTROY = 1000000;      // the sigma-outlier cut must never fire
Option, VERSION = 10900;

Title, string="sbend_gauss";

REAL Edes  = 0.1;
REAL gamma = (Edes + EMASS) / EMASS;
REAL beta  = sqrt(1 - (1 / gamma^2));
REAL P0    = gamma * beta * EMASS;    // GeV/c; also sets OpalData P0 (field ref)

REAL bend_angle = 0.1047197551196598;       // 6 deg
REAL L_BEND     = 0.6;       // SBEND L = design-orbit ARC length
REAL Z_IN       = 1;         // entrance face (path length)
REAL Z_OUT      = 1.6;        // exit face = Z_IN + design arc length

D_IN:    DRIFT,   L = 1, ELEMEDGE = 0.0;
MON_IN:  MONITOR, ELEMEDGE = 0.75, DELETEONTRANSVERSEEXIT = FALSE;
BEND:    SBEND,   L = L_BEND, ELEMEDGE = Z_IN,
         ANGLE = bend_angle,
         HGAP = 0.01,
         HAPERT = 0.04,
         DESIGNENERGY = 100;
MON_OUT: MONITOR, ELEMEDGE = 1.85, DELETEONTRANSVERSEEXIT = FALSE;
D_OUT:   DRIFT,   L = 0.6, ELEMEDGE = Z_OUT;

ApLine: Line = (D_IN, MON_IN, BEND, MON_OUT, D_OUT);

FS1: Fieldsolver, TYPE = NONE,
     NX = 16, NY = 16, NZ = 16,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

REAL n_particles = 5000;
Dist: DISTRIBUTION, TYPE = FROMFILE, FNAME = "parts.txt", NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist;
mySources: EMISSIONSOURCELIST = (ES1);
BEAM1: BEAM, PARTICLE = ELECTRON, NALLOC = n_particles,
       BCHARGE = 1.6e-15, SOURCES = mySources, CHARGE = -1;

TRACK, LINE = ApLine, BEAM = BEAM1,
       MAXSTEPS = 2000000, DT = 1e-12, ZSTOP = 2;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
