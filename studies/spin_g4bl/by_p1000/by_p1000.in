/*  by_p1000.in -- the g-2 test at p = 1.0 GeV/c.

    One metre of uniform By = 1.667820476 T, which bends a 1000 MeV/c muon by
    0.5 rad. The spin starts along the direction of travel, at (0, 0, 1).

    The spin turns (1 + G*gamma) times faster than the momentum, so after the bend
    the angle between them is

        G * gamma * theta = 5.548119e-03 rad = 5.5481 mrad

    with gamma = 9.517148. The field is scaled with the momentum so the bend
    angle stays at 0.5 rad across the whole scan: then this angle depends only
    on gamma, and the five cases together measure G.

    GENERATED by make_scan.py -- do not edit.
*/

OPTION, PSDUMPFREQ    = 100000;
OPTION, STATDUMPFREQ  = 10;
OPTION, BOUNDPDESTROY = 0;
OPTION, VERSION       = 10900;

Title, string="spin_g4bl / by_p1000";

REAL MUON_MASS = 0.1056583755;
REAL P0        = 1.0;

E01_MON_IN : MONITOR, X = 0.0, Y = 0.0, Z = 0.050,
             THETA = 0.0, PHI = 0.0, PSI = 0.0,
             DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_IN";

E02_BY     : FIELDMAP, X = 0.0, Y = 0.0, Z = 0.600,
             THETA = 0.0, PHI = 0.0, PSI = 0.0,
             FMAPFN = "by.g4blmap", SCALE = 1.0;

E03_MON_OUT: MONITOR, X = 0.0, Y = 0.0, Z = 1.200,
             THETA = 0.0, PHI = 0.0, PSI = 0.0,
             DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_OUT";

BendLine : LINE = (E01_MON_IN, E02_BY, E03_MON_OUT);

FS1: FIELDSOLVER, TYPE = NONE, NX = 8, NY = 8, NZ = 8,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

REAL n_particles = 1;
Dist1: DISTRIBUTION, TYPE = FROMFILE, FNAME = "parts.txt", NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1;
mySources: EMISSIONSOURCELIST = (ES1);

// Spin along the direction of travel. FROMFILE ignores any spin in parts.txt, so
// this one vector is what every particle starts with.
BEAM1: BEAM, PARTICLE = MUON, NALLOC = n_particles,
       BCHARGE = 1e-15, SOURCES = mySources, CHARGE = 1,
       POLARIZATION = {0.0, 0.0, 1.0};

TRACK, LINE = BendLine, BEAM = BEAM1,
       MAXSTEPS = {20000000},
       DT = {1e-13},
       ZSTOP = {1.40};
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
