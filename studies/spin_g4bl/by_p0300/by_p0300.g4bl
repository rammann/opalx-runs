# by_p0300.g4bl -- the g-2 test at p = 0.3 GeV/c.
#
# The same uniform By map OPALX reads. spinTracking=1 switches on Geant4's
# Thomas-BMT integration; decay is off, which also keeps spinTracking from
# swapping in the radiative decay channels.
#
# format=asciiExtended is the 28-column output carrying PolX PolY PolZ as text.
#
# GENERATED by make_scan.py -- do not edit.

physics QGSP_BERT disable=Decay doStochastics=0 spinTracking=1

param worldMaterial=Vacuum
param maxStep=0.05 deltaChord=0.0001

start x=0 y=0 z=0 initialZ=0 radiusCut=2000
reference particle=mu+ referenceMomentum=300
trackcuts keep=mu+ killSecondaries=1

beam ascii filename=beam.txt

box WORLDBOX height=800 width=3000 length=2000 material=Vacuum
place WORLDBOX z=700 x=200

fieldmap BY file=by.g4blmap
place BY z=600 current=1.

zntuple z=50,1200 format=asciiExtended coordinates=centerline
