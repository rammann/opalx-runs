/*
    Spin benchmark Case 2 -- pure magnetic field, transverse launch
    -----------------------------------------------------------------

    Goal: validate the OPALX Thomas-BMT integrator against the exact
    analytic Rodrigues rotation, in a configuration where the BMT
    angular velocity Omega is rigorously constant.

    Setup:
      - Single mu- with no decay.
      - Uniform B = +1 T * z_hat (from the SOLENOID + uniform fieldmap).
      - E = 0 in the field region.
      - Muon launched with momentum strictly along +x_hat (transverse to B),
        starting at z = R0Z (inside the solenoid).
        Because beta . B = 0 the gamma is rigorously conserved AND
        Omega = -(q/m) (a + 1/gamma) * B  is parallel to B and constant.
      - Spin initialized along +x_hat (i.e. along the initial momentum, helicity = +1).

    Concrete numerics (all stated up-front so the notebook can rebuild Omega):
      species mass    : m_mu = 0.105658 GeV
      gyromagnetic    : a_mu = 1.16592061e-3  (= (g-2)/2)
      reference gamma : 1.10  -> beta = 0.4166, beta*gamma = 0.4583
      cyclotron rad.  : r_c = pc / (0.3 B) ~ 0.16 m
                        (fits inside the fieldmap's r=[0, 0.5] m extent)
      B_z (design)    : 1.0 T  (KS = 1 with BF_Uniform.T7; normalization
                                puts the max field in the file at 1 T)

    Analytic frequencies (for the notebook to verify against):
      omega_c = (|q| B / m) / gamma          ~ 7.73e8 rad/s  (T_c ~ 8 ns)
      omega_s = (|q| B / m) (a + 1/gamma)    spin precession about B
      omega_a = (|q| B / m) * a              ~ 9.91e5 rad/s  (T_a ~ 6.3 us)
                ^ gamma-independent. Spin-momentum angle theta(t) = omega_a * t.

    Run length & resolution:
      DT       = 1 ns    -> >= 8 steps per cyclotron period
      MAXSTEPS = 20000   -> 20 us total ~ 3 spin-momentum (omega_a) periods
                                       and ~2400 cyclotron orbits
      STATDUMPFREQ = 1   -> per-step spin trace for smooth comparison
      PSDUMPFREQ = 200   -> 100 h5 phase-space + field snapshots
      OPTION EBDUMP = TRUE  -> Ex/Ey/Ez/Bx/By/Bz per particle per step,
                               so the notebook reads the actually-applied
                               B in OPALX units and feeds Rodrigues from that
                               (no guessing about KS conventions).
*/

OPTION, PSDUMPFREQ    = 200;
OPTION, STATDUMPFREQ  = 1;
OPTION, EBDUMP        = TRUE;
OPTION, BOUNDPDESTROY = 0;
OPTION, VERSION       = 10900;

Title, string="Spin benchmark Case 2: pure B, transverse launch";

Value, {OPALVERSION};

// ----------------------------------------------------------------------------
// Parameters
// ----------------------------------------------------------------------------

REAL n_muons       = 1;
REAL bunch_charge  = 1.602176634e-19;       // one elementary charge
REAL gamma_initial = 1.10;
REAL beta_initial  = sqrt(1.0 - 1.0/gamma_initial^2);  // ~0.4166
REAL bg_x          = beta_initial * gamma_initial;     // P0X in beta*gamma units

Value, {gamma_initial, beta_initial, bg_x};

// ----------------------------------------------------------------------------
// Beamline: solenoid sitting at z in [0, 5] m, drift before and after.
// The single muon starts at R0Z = 0.5 m (well inside the solenoid) flying
// in +x; the cyclotron orbit lies in the (x, y) plane at z = 0.5 m, so the
// particle stays in the field region indefinitely.
// ----------------------------------------------------------------------------

// Custom uniform-B fieldmap: r in [0, 20] m, z in [0, 20] m, Bz/max=1 with
// normalize_m=true (the Fieldmap default), KS=1 -> Bz = 1 T everywhere.
// OPALX opens this from its working folder: the case's run folder under output/
// (python -m opalxruns.run), which sits as deep as this folder does in studies/.
//
// SOL is short (L=1 m) because the test particle stays at z = R0Z = 0.5 m
// throughout the run (cyclotron orbit lives in (x,y), z is locked).
// The DRIFT D1 only exists to give the BEAM's reference particle -- which
// travels in +z at beta*c -- somewhere to be so that ZSTOP isn't hit before
// MAXSTEPS. The test particle itself never enters D1.
SOL: SOLENOID,
    L        = 1.0,
    ELEMEDGE = 0.0,
    KS       = 1.0,
    FMAPFN   = "../../../../shared/BF_Uniform_Large.T7";

// D1 length is sized so the reference particle (which is what gets walked
// by the OrbitThreader and ZSTOP) doesn't run out of beamline during the
// MAXSTEPS run, but isn't so long that the threader's pre-tracking walk
// blows up. For the planned 20 us run at gamma=1.10:
//   reference distance = beta * c * (MAXSTEPS * DT)
//                      = 0.417 * 3e8 * 20e-6  =  2500 m
// We pick D1 L = 3000 m (and matching ZSTOP) for a comfortable margin.
D1:  DRIFT,
    L        = 3000.0,
    ELEMEDGE = 1.0;

myLine: Line = (SOL, D1);

// ----------------------------------------------------------------------------
// Distribution: exactly one particle, all sigmas zero.
// ----------------------------------------------------------------------------

DistMuon: DISTRIBUTION, TYPE = GAUSS,
    SIGMAX    = 0.0,
    SIGMAY    = 0.0,
    SIGMAZ    = 0.0,
    SIGMAPX   = 0.0,
    SIGMAPY   = 0.0,
    SIGMAPZ   = 0.0,
    NPARTDIST = n_muons;

// ----------------------------------------------------------------------------
// Emission source: place the particle at z = 0.5 m and give it momentum
// strictly along +x (transverse to B_z).
//
// IMPORTANT 1: the Gaussian distribution adds the BEAM's reference (beta*gamma)
// = bg_x along +z to every sampled particle, then P0X/P0Y/P0Z are added on
// top. To get a pure +x launch we must cancel that reference contribution
// with P0Z = -bg_x. Result: final momentum = (bg_x, 0, 0).
//
// IMPORTANT 2: T0 = 1e-12 (deferred emission). When the bunch already
// contains particles at t = 0, ParallelTracker initialises the
// OrbitThreader reference momentum to the bunch mean, which is along +x for
// us; the threader then walks +x looking for elements along the beamline
// (which sits along +z) and never terminates. Setting T0 > 0 keeps the
// bunch empty at t = 0, so RefPartP defaults to (0, 0, beta*gamma) along
// the beamline -- the threader runs in microseconds. The Gaussian then
// emits the single muon during the very first step whose [t, t+DT] window
// contains T0 = 1e-12.
// ----------------------------------------------------------------------------

ES_Muon: EMISSIONSOURCE,
    DISTRIBUTION = DistMuon,
    R0X = 0.0,
    R0Y = 0.0,
    R0Z = 0.5,
    P0X = bg_x,                                       // +x component
    P0Y = 0.0,
    P0Z = -bg_x,                                      // cancel reference +z
    T0  = 1e-12;                                      // defer emission

Sources_Muon: EMISSIONSOURCELIST = (ES_Muon);

// ----------------------------------------------------------------------------
// Muon BEAM: GAMMA matches the launch energy, POLARIZATION along the
// initial momentum direction so the spin-momentum angle grows from zero.
// No GLOBALPROCESSES -> no decay.
// ----------------------------------------------------------------------------

MBEAM: BEAM,
    PARTICLE     = MUON,
    GAMMA        = gamma_initial,
    NALLOC       = n_muons,
    BCHARGE      = bunch_charge,
    SOURCES      = Sources_Muon,
    CHARGE       = -1,
    POLARIZATION = {1.0, 0.0, 0.0};                   // along initial momentum

// ----------------------------------------------------------------------------
// No space charge.
// ----------------------------------------------------------------------------

FS1: Fieldsolver, TYPE = NONE,
    NX = 2, NY = 2, NZ = 2,
    PARFFTX = true,  PARFFTY = true,  PARFFTZ = true,
    BCFFTX  = OPEN,  BCFFTY  = OPEN,  BCFFTZ  = OPEN,
    BBOXINCR = 5,
    GREENSF  = STANDARD;

// ----------------------------------------------------------------------------
// Tracking
// ----------------------------------------------------------------------------

TRACK, LINE     = myLine,
       BEAMS    = {MBEAM},
       MAXSTEPS = 20000,
       DT       = {1e-9},
       ZSTOP    = 3000.0;

RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
QUIT;
