/*  asr61_300sm.in -- muE4 ASR61_300sm map, moved onto the axis so a beam can reach it.

    Paired with asr61_300sm.g4bl: the same 19 muons and the same map files go
    through both codes. Nothing else can differ -- no space charge, no material,
    no decay, no scraping.

    A FIELDMAP element takes neither ELEMEDGE nor L, and OPALX allows one
    placement convention per beamline, so every element here is placed by
    absolute position and rotation. The element's local frame is the map's own
    frame, so Z is the lab position of the map's z = 0.

    DT = 1e-12 s: the step at which OPALX has stopped moving. At 1e-11 it is
    still 30 um short of its own limit on this geometry, which would read as a
    disagreement with G4beamline that has nothing to do with the map.

    GENERATED by make_cases.py -- do not edit.
*/

OPTION, PSDUMPFREQ    = 100000;
OPTION, STATDUMPFREQ  = 1;        // reference orbit and its field, every step
OPTION, BOUNDPDESTROY = 1000000;  // never trip the statistical loss box
OPTION, VERSION       = 10900;

Title, string="g4bl_compare / asr61_300sm";

REAL MUON_MASS = 0.1056583755;              // GeV
REAL P0        = 0.028;                     // GeV/c; FROMFILE forbids PC on BEAM
REAL BG0       = P0 / MUON_MASS;
REAL BRHO      = P0 / 0.299792458;

value, {P0, BG0, BRHO};

E01_MON_400: MONITOR, X = 0.0, Y = 0.0, Z = 0.400000,
    THETA = 0.0, PHI = 0.0, PSI = 0.0,
    DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_400";

E02_MON_700: MONITOR, X = 0.0, Y = 0.0, Z = 0.700000,
    THETA = 0.0, PHI = 0.0, PSI = 0.0,
    DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_700";

E03_MON_900: MONITOR, X = 0.0, Y = 0.0, Z = 0.900000,
    THETA = 0.0, PHI = 0.0, PSI = 0.0,
    DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_900";

E04_MON_1100: MONITOR, X = 0.0, Y = 0.0, Z = 1.100000,
    THETA = 0.0, PHI = 0.0, PSI = 0.0,
    DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_1100";

E05_MON_1330: MONITOR, X = 0.0, Y = 0.0, Z = 1.330000,
    THETA = 0.0, PHI = 0.0, PSI = 0.0,
    DELETEONTRANSVERSEEXIT = FALSE, OUTFN = "MON_1330";

// g4bl: place ... z=1880.0000 current=-9.95280E-01
E06_ASR61_300SM_: FIELDMAP, X = -0.505000000, Y = 0.000000000, Z = 1.880000000,
    THETA = 0.000000000, PHI = 0.000000000, PSI = 0.000000000,
    FMAPFN = "/Users/rammann/Code/OPALX/g4bl-files/muE4/maps/asr61_300sm_track.g4blmap",
    SCALE = -9.952800E-01;

CaseLine : LINE = (E01_MON_400, E02_MON_700, E03_MON_900, E04_MON_1100, E05_MON_1330, E06_ASR61_300SM_);

// Field sampling, in lab metres. OPALX writes these into data/, not here.
// `grid` lands on the map's own grid points, `half` halfway between them,
// `yscan` walks the full height. See make_cases.py for why.
DUMPEMFIELDS, FILE_NAME = "opalx_field_grid.dat", COORDINATE_SYSTEM = CARTESIAN,
    X_START = -0.125000000, DX = 0.010000000, X_STEPS = 25,
    Y_START = 0.000000000, DY = 0.010000000, Y_STEPS = 1,
    Z_START = 0.500000000, DZ = 0.005000000, Z_STEPS = 146,
    T_START = 0.0, DT = 1.0, T_STEPS = 1;

DUMPEMFIELDS, FILE_NAME = "opalx_field_half.dat", COORDINATE_SYSTEM = CARTESIAN,
    X_START = -0.120000000, DX = 0.010000000, X_STEPS = 25,
    Y_START = 0.005000000, DY = 0.010000000, Y_STEPS = 1,
    Z_START = 0.502500000, DZ = 0.005000000, Z_STEPS = 146,
    T_START = 0.0, DT = 1.0, T_STEPS = 1;

DUMPEMFIELDS, FILE_NAME = "opalx_field_yscan.dat", COORDINATE_SYSTEM = CARTESIAN,
    X_START = -0.115000000, DX = 0.110000000, X_STEPS = 3,
    Y_START = -0.110000000, DY = 0.010000000, Y_STEPS = 23,
    Z_START = 0.505000000, DZ = 0.360000000, Z_STEPS = 3,
    T_START = 0.0, DT = 1.0, T_STEPS = 1;

DUMPEMFIELDS, FILE_NAME = "opalx_field_edge.dat", COORDINATE_SYSTEM = CARTESIAN,
    X_START = 0.125000000, DX = 0.010000000, X_STEPS = 1,
    Y_START = -0.120000000, DY = 0.010000000, Y_STEPS = 24,
    Z_START = 0.500000000, DZ = 0.005000000, Z_STEPS = 146,
    T_START = 0.0, DT = 1.0, T_STEPS = 1;


FS1: FIELDSOLVER, TYPE = NONE, NX = 16, NY = 16, NZ = 16,
     PARFFTX = true, PARFFTY = true, PARFFTZ = true,   // required even for NONE
     BCFFTX = open, BCFFTY = open, BCFFTZ = open,
     BBOXINCR = 1, GREENSF = INTEGRATED;

REAL n_particles = 19;
Dist1: DISTRIBUTION, TYPE = FROMFILE, FNAME = "parts.txt", NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1;   // EMISSIONMODEL stays NONE for FROMFILE
mySources: EMISSIONSOURCELIST = (ES1);

// CHARGE = 1 is mandatory: ParticleProperties maps MUON to -1 and Beam::execute
// only consults that table when the attribute is absent. Check run.log for
// "CHARGE      +e * 1" -- a charge sign error looks exactly like a map that is
// turned the wrong way round.
BEAM1: BEAM, PARTICLE = MUON, NALLOC = n_particles,
       BCHARGE = 1e-15, SOURCES = mySources, CHARGE = 1;

// ZSTOP is accumulated path length, not lab z. The orbit turns, so s runs ahead
// of z and the two stop being the same number once the field starts to bend it.
TRACK, LINE = CaseLine, BEAM = BEAM1,
       MAXSTEPS = {8000000},
       DT = {1e-12},
       ZSTOP = {1.600};
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;
