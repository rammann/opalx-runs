# wsx_solenoid_gauss.g4bl -- muE4 WSX solenoid, ISOLATED, 5000-particle Gaussian.
#
# Same solenoid, same geometry and same frame as ../wsx_solenoid/. Only the beam
# differs: 5000 particles from a Gaussian with sigma_x != sigma_y, so the Larmor
# rotation shows up as the x-y ellipse turning as it goes through the field.
#
# beam.txt is written by compare_gauss.ipynb, which writes parts.txt from the
# same array so the two codes cannot get different particles.
#
# FRAME: z here [mm] / 1000 == path length s in wsx_solenoid_gauss.in [m].
#   Map local z runs -1500..+1500 mm, placed at 1800 -> field at 300..3300 mm.
#
# Run from this directory:
#   source /Users/rammann/Code/G4BL/G4beamline-3.08.app/Contents/root/bin/thisroot.sh
#   g4bl wsx_solenoid_gauss.g4bl

physics QGSP_BERT disable=Decay doStochastics=0

param worldMaterial=Vacuum
param maxStep=1.0 deltaChord=0.01

# `start` must precede every `place`.
start x=0 y=0 z=0 initialZ=0 radiusCut=550
reference particle=mu+ referenceMomentum=28
trackcuts keep=mu+ killSecondaries=1

beam ascii filename=beam.txt

# `fieldmap` places no volume, so nothing would expand the world without this.
tubs WORLDPIPE innerRadius=0 outerRadius=600 length=4200 material=Vacuum
place WORLDPIPE z=1800

fieldmap MAG file=../../../../../g4bl-files/muE4/maps/wsx_total.g4blmap current=1.
place MAG z=1800 rotation=Y180

# 8 planes: 150 and 3450 sit in field-free drift, the middle six are inside the
# field so the rotation can be watched developing. -> Z150.txt ... Z3450.txt
zntuple z=150,600,1050,1500,1950,2400,2850,3450 format=ascii coordinates=centerline

fieldntuple AXIS format=ascii filename=g4bl_axis.txt x=0 y=0 z=250,3350,1 t=0
