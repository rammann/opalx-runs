/*  mue4_analytical.in  -- OPALX translation of mue4_analytical.g4bl
    Idealized ANALYTIC twin of the muE4 muon channel (WSX solenoid ON), mu+ 28 MeV/c.
    No field maps, no read-in bunch -- everything analytic:
      beam gaussian    -> DISTRIBUTION GAUSS  (pc=0.028 on BEAM -> reference orbit is
                          the 28 MeV/c design, so NO bunch-mean over-bending issue).
                          sigmas matched to the injected distribution; SIGMAP* are in
                          beta*gamma = sigma_angle * (P/mc).
      coil+solenoid    -> SOLENOID + on-axis Astra-1D map (peak 0.19 T; make_analytic_solenoid.py).
      idealsectorbend  -> SBEND (ANGLE = g4bl angle 20/-17/17 deg; L=R*|angle|; field from P0).
                          HGAP = 0.02 is the half pole gap: it scales the Enge fringe AND
                          sets the vertical half-aperture (+/-20 mm). HAPERT = 0.12 is the
                          horizontal half-aperture. The bends scrape in both planes.
      genericquad      -> QUADRUPOLE, K1 = current*8.188865 (same calibration as the field-map deck).
      FS collimators   -> DRIFT + rectangle aperture (V/H split at their real z), SCRAPING.
      Stop_SECTION     -> DRIFT + circle(0.60) (+/-300 mm bore beam stops).
      zntuple planes   -> 20 MONITOR (DELETEONTRANSVERSEEXIT=FALSE: record, do not scrape).
    Generated by tools/build_deck.py.  Aperture scraping is active (implement-aperture branch).
*/

OPTION, PSDUMPFREQ    = 100;
OPTION, STATDUMPFREQ  = 1;
OPTION, BOUNDPDESTROY = 10;
OPTION, VERSION       = 10900;

Title, string="muE4 analytic twin (WSX on) -- Gaussian beam, analytic magnets";

REAL MUON_MASS = 0.1056583755;                  // [GeV]
REAL P0        = 0.028;                     // [GeV/c]  (reference for fields AND design orbit)
REAL Edes      = sqrt(P0*P0 + MUON_MASS*MUON_MASS) - MUON_MASS;
REAL n_particles = 200000;                     // g4bl actual run = 200000 (nPart default 50000 overridden)

SOL: SOLENOID, L = 2.785, ELEMEDGE = 0.0, FMAPFN = "../../../../shared/wsx_analytic_1D.map", KS = 1.0, APERTURE = "circle(0.42)";
//BEND1: SBEND, L = 0.40459, ELEMEDGE = 2.57800, ANGLE = -0.349066, HGAP = 0.02, HAPERT = 0.12, DESIGNENERGY = 3.647124;
//BEND2: SBEND, L = 0.36192, ELEMEDGE = 7.14246, ANGLE = +0.296706, HGAP = 0.02, HAPERT = 0.12, DESIGNENERGY = 3.647124;
//BEND3: SBEND, L = 0.36192, ELEMEDGE = 11.67044, ANGLE = -0.296706, HGAP = 0.02, HAPERT = 0.12, DESIGNENERGY = 3.647124;
BEND1: SBEND, L = 0.40459, ELEMEDGE = 2.57800, ANGLE = -0.349066, HGAP = 0.02, HAPERT = 0.12;
BEND2: SBEND, L = 0.36192, ELEMEDGE = 7.14246, ANGLE = +0.296706, HGAP = 0.02, HAPERT = 0.12;
BEND3: SBEND, L = 0.36192, ELEMEDGE = 11.67044, ANGLE = -0.296706, HGAP = 0.02, HAPERT = 0.12;
Q01: QUADRUPOLE, L = 0.395, ELEMEDGE = 4.53790, K1 = -1.747504, APERTURE = "circle(0.50)";   // I=-0.21340
Q02: QUADRUPOLE, L = 0.395, ELEMEDGE = 5.04290, K1 = +5.332589, APERTURE = "circle(0.50)";   // I=+0.65120
Q03: QUADRUPOLE, L = 0.395, ELEMEDGE = 5.54790, K1 = -2.863646, APERTURE = "circle(0.50)";   // I=-0.34970
Q04: QUADRUPOLE, L = 0.395, ELEMEDGE = 9.06590, K1 = -1.604199, APERTURE = "circle(0.50)";   // I=-0.19590
Q05: QUADRUPOLE, L = 0.395, ELEMEDGE = 9.57090, K1 = +5.141788, APERTURE = "circle(0.50)";   // I=+0.62790
Q06: QUADRUPOLE, L = 0.395, ELEMEDGE = 10.07590, K1 = -3.033156, APERTURE = "circle(0.50)";   // I=-0.37040
Q07: QUADRUPOLE, L = 0.395, ELEMEDGE = 13.23340, K1 = -2.632720, APERTURE = "circle(0.50)";   // I=-0.32150
Q08: QUADRUPOLE, L = 0.395, ELEMEDGE = 13.73840, K1 = +5.191740, APERTURE = "circle(0.50)";   // I=+0.63400
Q09: QUADRUPOLE, L = 0.395, ELEMEDGE = 14.24340, K1 = -2.602421, APERTURE = "circle(0.50)";   // I=-0.31780
Q10: QUADRUPOLE, L = 0.395, ELEMEDGE = 17.27340, K1 = +3.699729, APERTURE = "circle(0.50)";   // I=+0.45180
Q11: QUADRUPOLE, L = 0.395, ELEMEDGE = 17.77840, K1 = -7.413379, APERTURE = "circle(0.50)";   // I=-0.90530
Q12: QUADRUPOLE, L = 0.395, ELEMEDGE = 18.28340, K1 = +7.279901, APERTURE = "circle(0.50)";   // I=+0.88900
FS61V: DRIFT, L = 0.100, ELEMEDGE = 3.78040, APERTURE = "rectangle(2.0,0.210)";
FS61H: DRIFT, L = 0.100, ELEMEDGE = 3.93040, APERTURE = "rectangle(0.380,2.0)";
FS62: DRIFT, L = 0.100, ELEMEDGE = 7.45440, APERTURE = "rectangle(0.380,2.0)";
FS63V: DRIFT, L = 0.100, ELEMEDGE = 11.02690, APERTURE = "rectangle(2.0,0.210)";
FS63H: DRIFT, L = 0.100, ELEMEDGE = 11.17690, APERTURE = "rectangle(0.380,2.0)";
STOP_0250: DRIFT, L = 0.100, ELEMEDGE = 2.45000, APERTURE = "circle(0.60)";
STOP_0350: DRIFT, L = 0.100, ELEMEDGE = 3.45000, APERTURE = "circle(0.60)";
STOP_0600: DRIFT, L = 0.100, ELEMEDGE = 5.95000, APERTURE = "circle(0.60)";
STOP_0700: DRIFT, L = 0.100, ELEMEDGE = 6.95000, APERTURE = "circle(0.60)";
STOP_0800: DRIFT, L = 0.100, ELEMEDGE = 7.95000, APERTURE = "circle(0.60)";
STOP_1100: DRIFT, L = 0.100, ELEMEDGE = 10.95000, APERTURE = "circle(0.60)";
STOP_1150: DRIFT, L = 0.100, ELEMEDGE = 11.45000, APERTURE = "circle(0.60)";
STOP_1200: DRIFT, L = 0.100, ELEMEDGE = 11.95000, APERTURE = "circle(0.60)";
STOP_1500: DRIFT, L = 0.100, ELEMEDGE = 14.95000, APERTURE = "circle(0.60)";
STOP_1700: DRIFT, L = 0.100, ELEMEDGE = 16.95000, APERTURE = "circle(0.60)";
STOP_1900: DRIFT, L = 0.100, ELEMEDGE = 18.95000, APERTURE = "circle(0.60)";
mon_01_sol_in: MONITOR, ELEMEDGE = 0.3000, DELETEONTRANSVERSEEXIT = FALSE;
mon_02_sol_out: MONITOR, ELEMEDGE = 2.3000, DELETEONTRANSVERSEEXIT = FALSE;
mon_03_bend1_in: MONITOR, ELEMEDGE = 2.6800, DELETEONTRANSVERSEEXIT = FALSE;
mon_04_bend1_out: MONITOR, ELEMEDGE = 3.3000, DELETEONTRANSVERSEEXIT = FALSE;
mon_05_fs61_in: MONITOR, ELEMEDGE = 3.8500, DELETEONTRANSVERSEEXIT = FALSE;
mon_06_fs61_out: MONITOR, ELEMEDGE = 4.1000, DELETEONTRANSVERSEEXIT = FALSE;
mon_07_q1_in: MONITOR, ELEMEDGE = 4.4500, DELETEONTRANSVERSEEXIT = FALSE;
mon_08_q1_out: MONITOR, ELEMEDGE = 6.0500, DELETEONTRANSVERSEEXIT = FALSE;
mon_09_bend2_in: MONITOR, ELEMEDGE = 7.1500, DELETEONTRANSVERSEEXIT = FALSE;
mon_10_bend2_out: MONITOR, ELEMEDGE = 7.8500, DELETEONTRANSVERSEEXIT = FALSE;
mon_11_q2_in: MONITOR, ELEMEDGE = 8.9500, DELETEONTRANSVERSEEXIT = FALSE;
mon_12_q2_out: MONITOR, ELEMEDGE = 10.6000, DELETEONTRANSVERSEEXIT = FALSE;
mon_13_fs63_in: MONITOR, ELEMEDGE = 11.1000, DELETEONTRANSVERSEEXIT = FALSE;
mon_14_fs63_out: MONITOR, ELEMEDGE = 11.3500, DELETEONTRANSVERSEEXIT = FALSE;
mon_15_bend3_in: MONITOR, ELEMEDGE = 11.7500, DELETEONTRANSVERSEEXIT = FALSE;
mon_16_bend3_out: MONITOR, ELEMEDGE = 12.3500, DELETEONTRANSVERSEEXIT = FALSE;
mon_17_q3_in: MONITOR, ELEMEDGE = 13.1500, DELETEONTRANSVERSEEXIT = FALSE;
mon_18_q3_out: MONITOR, ELEMEDGE = 14.7500, DELETEONTRANSVERSEEXIT = FALSE;
mon_19_q4_in: MONITOR, ELEMEDGE = 17.1500, DELETEONTRANSVERSEEXIT = FALSE;
mon_20_q4_out: MONITOR, ELEMEDGE = 18.8000, DELETEONTRANSVERSEEXIT = FALSE;

muE4line: Line = (
    SOL, mon_01_sol_in, mon_02_sol_out, STOP_0250, BEND1,
    mon_03_bend1_in, mon_04_bend1_out, STOP_0350, FS61V, mon_05_fs61_in,
    FS61H, mon_06_fs61_out, mon_07_q1_in, Q01, Q02,
    Q03, STOP_0600, mon_08_q1_out, STOP_0700, BEND2,
    mon_09_bend2_in, FS62, mon_10_bend2_out, STOP_0800, mon_11_q2_in,
    Q04, Q05, Q06, mon_12_q2_out, STOP_1100,
    FS63V, mon_13_fs63_in, FS63H, mon_14_fs63_out, STOP_1150,
    BEND3, mon_15_bend3_in, STOP_1200, mon_16_bend3_out, mon_17_q3_in,
    Q07, Q08, Q09, mon_18_q3_out, STOP_1500,
    STOP_1700, mon_19_q4_in, Q10, Q11, Q12,
    mon_20_q4_out, STOP_1900
);

// ---- Gaussian beam matched to the injected muE4 distribution ----
Dist1: DISTRIBUTION, TYPE = GAUSS,
    SIGMAX = 0.01092, SIGMAY = 0.00797, SIGMAZ = 0.0001,
    SIGMAPX = 0.0638662, SIGMAPY = 0.0635217, SIGMAPZ = 0.0129663,
    NPARTDIST = n_particles;
ES1: EMISSIONSOURCE, DISTRIBUTION = Dist1;
mySources: EMISSIONSOURCELIST = (ES1);

FS1: Fieldsolver, TYPE = NONE,
    NX = 16, NY = 16, NZ = 16,
    PARFFTX = true, PARFFTY = true, PARFFTZ = true,
    BCFFTX = open, BCFFTY = open, BCFFTZ = open,
    BBOXINCR = 1, GREENSF = INTEGRATED;

// GAUSS distribution -> pc IS set on the BEAM (reference = design momentum).
BEAM1: BEAM, PARTICLE = MUON, pc = P0, NALLOC = n_particles,
       BCHARGE = 1e-15, SOURCES = mySources, CHARGE = +1;

TRACK, LINE = muE4line, BEAM = BEAM1,
       MAXSTEPS = 100000, DT = {1e-11}, ZSTOP = 19.25;
RUN, METHOD = "PARALLEL", FIELDSOLVER = FS1;
ENDTRACK;
Quit;

