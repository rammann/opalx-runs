# Run output. Runs write into output/, which has the same folder tree as studies/.
/output/

# OPALX run output -- all regenerable from the input file + the binary. These
# rules also catch output of a run started by hand inside studies/.
*.h5
*.stat
*.lbal
*.trackOrbit
*.log
timing.dat
errormsg.txt

# ParaView / VTK export
*.vtp
*.vtu
*.pvd
paraview/

# OPALX per-run geometry export: OPALX writes a folder named `data` in the
# working directory.
data/
*_DesignPath.dat
*_ElementPositions.py
*_ElementPositions.sdds
*_ElementPositions.txt
*_3D.opal

# plots
plots/
monitor_plots/
*.png
*.csv

# python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

.DS_Store

# `*.dat` is deliberately not blanket-ignored: timing.dat and *_DesignPath.dat
# are covered above by name, while shared/beam_WsxOn*.dat is a committed input.
# `parts.txt` is likewise kept -- the input files will not run without it.
